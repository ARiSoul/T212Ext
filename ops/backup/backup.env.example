# Copy to ops/backup/backup.env on the server and fill in. Not committed (see .gitignore).
# See docs/DEPLOYMENT.md, "Backups and monitoring".

# Off-site target: Hetzner Storage Box over SSH (port 23). Path is relative to the box's home.
# A folder of its own: the upload mirrors it with --delete.
REMOTE="u123456@u123456.your-storagebox.de:t212ext-backups"
SSH_PORT=23
SSH_KEY="$HOME/.ssh/storagebox_ed25519"

# Local staging copy (also what gets mirrored to the remote, retention included).
BACKUP_DIR="/var/backups/t212ext"
KEEP_DAILY=7
KEEP_WEEKLY=4

# Required: every backup is encrypted with this passphrase (gpg symmetric, AES256).
# Keep a copy of the passphrase OUTSIDE the server (password manager), or the backups
# cannot be restored if the server is lost.
GPG_PASSPHRASE_FILE="$HOME/.config/t212ext/backup.passphrase"

# Optional: dead man's switch (e.g. healthchecks.io). Pinged on success; "/fail" appended on error.
PING_URL=""

# The shared SQL Server's container. The nightly backup signs in as the app's own login
# (password from ~/t212ext/.env); only the restore test needs sa, read from SA_ENV_FILE.
DB_CONTAINER="traceon-db"
SA_ENV_FILE="$HOME/traceon/.env"
SA_ENV_KEY="DB_SA_PASSWORD"
