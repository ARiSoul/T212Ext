<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>arisoul-t212ext-web</UserSecretsId>
    <!-- Brings blazor.web.js (Microsoft.AspNetCore.App.Internal.Assets). The SDK adds it only when
         .razor files exist at restore time, and the Dockerfile restores from the project files alone. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <!-- Only for copy-from-sqlserver (3.0.0, the move to PostgreSQL): goes with it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pinned: Microsoft.Data.SqlClient 6.1.6 brings 9.0.11, affected by CVE-2026-84008 and CVE-2026-70162
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Goes with the SQL Server package. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\T212Ext.Core\T212Ext.Core.csproj" />
  </ItemGroup>

</Project>
