@page "/sync"
@inject OverviewQueries Overview
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav_SyncLog"] · T212Ext</PageTitle>

<div class="page-header">
    <div class="me-auto">
        <h1>@L["Nav_SyncLog"]</h1>
        <p>@L["SyncLog_Subtitle"]</p>
    </div>
    <SyncButton ShowFullHistory="true" Finished="LoadAsync" />
</div>

<DataGrid TItem="SyncRunRow" Items="_runs" Columns="Columns" StorageKey="sync-log" ExportFileName="sync-log"
          DefaultSortKey="started" DefaultSortDescending="true" EmptyText="@L["SyncLog_Empty"]" />

@code {
    private IReadOnlyList<SyncRunRow>? _runs;

    private IReadOnlyList<GridColumn<SyncRunRow>> Columns => [
        new() { Key = "started", Title = L["Col_Started"], Value = r => r.StartedAt, Text = r => Fmt.DateTime(r.StartedAt), MobileTitle = true,
                Filterable = true, FilterKey = r => r.StartedAt.ToLocalTime().ToString("d"), FilterValuesDescending = true },
        new() { Key = "account", Title = L["Common_Account"], Value = r => r.AccountName ?? "—", Filterable = true, HideBelow = "md" },
        new() { Key = "job", Title = L["Col_Job"], Value = r => Labels.Job(L, r.Job), Filterable = true },
        new() { Key = "added", Title = L["Col_Added"], Value = r => r.ItemsAdded, AlignEnd = true, Summaries = GridColumn<SyncRunRow>.Numeric, SummaryText = n => Fmt.Number(Math.Round(n, 1)) },
        new() { Key = "updated", Title = L["Col_Updated"], Value = r => r.ItemsUpdated, AlignEnd = true, HideBelow = "lg", Summaries = GridColumn<SyncRunRow>.Numeric, SummaryText = n => Fmt.Number(Math.Round(n, 1)) },
        new() { Key = "duration", Title = L["Col_Duration"], Value = r => r.FinishedAt is { } f ? (decimal)(f - r.StartedAt).TotalSeconds : null,
                Text = r => r.FinishedAt is { } f ? $"{(f - r.StartedAt).TotalSeconds:N1} s" : "—", AlignEnd = true, HideBelow = "xl", HideOnMobile = true,
                Summaries = [SummaryKind.Sum, SummaryKind.Avg, SummaryKind.Max], SummaryText = n => $"{n:N1} s" },
        new() { Key = "result", Title = L["Col_Result"], Value = r => r.Succeeded ? L["Common_Ok"].Value : L["Common_Failed"].Value, Filterable = true,
                Template = r => @<div>
                    @if (r.Succeeded)
                    {
                        <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> @L["Common_Ok"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger"><i class="bi bi-x-lg"></i> @L["Common_Failed"]</span>
                        <div class="small text-danger text-break mt-1">@r.Error</div>
                    }
                </div> },
    ];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _runs = await Overview.GetRecentRunsAsync(500);
}
