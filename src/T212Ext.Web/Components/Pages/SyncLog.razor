@page "/sync"
@inject OverviewQueries Overview

<PageTitle>Sync log · T212Ext</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">Sync log</h1>
    <SyncButton ShowFullHistory="true" Finished="LoadAsync" />
</div>

<p class="small text-body-secondary">
    A sync reads the account summary and positions, then the dividend, order and transaction history, newest
    first, until a page brings nothing new. "Full history" reads everything again; use it after Trading 212
    fixes history it had missed.
</p>

@if (_runs is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (_runs.Count == 0)
{
    <p class="text-body-secondary">No sync has run yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Started</th>
                    <th>Account</th>
                    <th>Job</th>
                    <th class="text-end">Added</th>
                    <th class="text-end d-none d-sm-table-cell">Updated</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in _runs)
                {
                    <tr>
                        <td class="text-nowrap">@Format.DateTime(run.StartedAt)</td>
                        <td>@(run.AccountName ?? "—")</td>
                        <td>@run.Job</td>
                        <td class="text-end">@run.ItemsAdded</td>
                        <td class="text-end d-none d-sm-table-cell">@run.ItemsUpdated</td>
                        <td>
                            @if (run.Succeeded)
                            {
                                <span class="badge text-bg-success">OK</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Failed</span>
                                <div class="small text-danger text-break">@run.Error</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<SyncRunRow>? _runs;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _runs = await Overview.GetRecentRunsAsync(100);
}
