@page "/import"
@using Arisoul.T212Ext.Core.Import
@inject OverviewQueries Overview
@inject CsvImportService ImportService
@inject ILogger<Import> Logger

<PageTitle>Import CSV · T212Ext</PageTitle>

<h1 class="h3 mb-3">Import CSV reports</h1>

<p>
    In the Trading 212 app: <strong>Menu → History → Export</strong>, pick the period (one year at most per
    report), and include dividends, interest and transactions. Choose all the reports at once; overlapping
    periods are fine. Importing adds the tax withheld on each dividend (the API does not give it) and fills
    gaps the API leaves. Importing the same file twice changes nothing.
</p>

@if (_accounts.Count == 0)
{
    <div class="alert alert-info">No account is configured.</div>
}
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <select class="form-select w-auto" aria-label="Account" @bind="_accountId" disabled="@_busy">
            @foreach (var account in _accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
        </select>
        <InputFile class="form-control flex-grow-1" style="min-width: 0; max-width: 28rem" accept=".csv" multiple
                   OnChange="OnFilesChosen" disabled="@_busy" />
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span class="small text-body-secondary">@_progress</span>
        }
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_results.Count > 1)
{
    <div class="alert alert-success">
        @_results.Count files: @_results.Sum(r => r.Result?.DividendsAdded ?? 0) new dividends,
        @_results.Sum(r => r.Result?.TransactionsAdded ?? 0) new cash movements.
    </div>
}

@foreach (var (fileName, result, error) in _results)
{
    <div class="card mb-3">
        <div class="card-header">@fileName</div>
        @if (error is not null)
        {
            <div class="card-body text-danger">@error</div>
        }
        else if (result is not null)
        {
            <ul class="list-group list-group-flush">
                <li class="list-group-item">Dividends: @result.DividendsAdded new, @result.DividendsMatched already known</li>
                <li class="list-group-item">Cash movements: @result.TransactionsAdded new, @result.TransactionsMatched already known</li>
                <li class="list-group-item">Buys and sells skipped: @result.OrdersSkipped (orders come from the API)</li>
                @if (result.OtherSkipped.Count > 0)
                {
                    <li class="list-group-item">
                        Other lines skipped: @string.Join(", ", result.OtherSkipped.Select(o => $"{o.Key} ({o.Value})"))
                    </li>
                }
                @foreach (var line in result.Errors)
                {
                    <li class="list-group-item list-group-item-warning">Line @line.LineNumber: @line.Message</li>
                }
            </ul>
        }
    </div>
}

@code {
    private const long MaxFileSize = 20 * 1024 * 1024;
    private const int MaxFiles = 20;

    private IReadOnlyList<AccountOverview> _accounts = [];
    private int _accountId;
    private bool _busy;
    private string? _progress;
    private string? _error;
    private readonly List<(string FileName, CsvImportResult? Result, string? Error)> _results = [];

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Overview.GetAccountsAsync();
        _accountId = _accounts.FirstOrDefault()?.Id ?? 0;
    }

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        _busy = true;
        _error = null;
        _results.Clear();

        try
        {
            if (e.FileCount > MaxFiles)
            {
                _error = $"Choose at most {MaxFiles} files at a time.";
                return;
            }

            // Oldest period first reads naturally in the results; the import itself does not depend on order.
            var files = e.GetMultipleFiles(MaxFiles).OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToList();
            for (var i = 0; i < files.Count; i++)
            {
                _progress = $"{i + 1} of {files.Count}: {files[i].Name}";
                StateHasChanged();
                _results.Add(await ImportAsync(files[i]));
            }
        }
        finally
        {
            _busy = false;
            _progress = null;
        }
    }

    private async Task<(string, CsvImportResult?, string?)> ImportAsync(IBrowserFile file)
    {
        try
        {
            // Copy first: the browser stream cannot be read synchronously by the parser.
            using var buffer = new MemoryStream();
            await using (var upload = file.OpenReadStream(MaxFileSize))
                await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            return (file.Name, await ImportService.ImportAsync(_accountId, buffer), null);
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            return (file.Name, null, ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV import of {File} failed", file.Name);
            return (file.Name, null, "The import failed. See the server log for details.");
        }
    }
}
