@page "/import"
@using Arisoul.T212Ext.Core.Import
@using Arisoul.T212Ext.Core.Reports
@using Microsoft.Extensions.Options
@inject OverviewQueries Overview
@inject ReportQueries Reports
@inject IOptions<ReportOptions> ReportOptions
@inject CsvImportService ImportService
@inject IStringLocalizer<SharedResource> L
@inject ILogger<Import> Logger

<PageTitle>@L["Nav_Import"] · T212Ext</PageTitle>

<div class="page-header">
    <div class="me-auto">
        <h1>@L["Import_Title"]</h1>
        <p>@L["Import_Subtitle"]</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <ol class="mb-3 ps-3">
            <li>@((MarkupString)L["Import_Step1"].Value)</li>
            <li>@L["Import_Step2"]</li>
            <li>@L["Import_Step3"]</li>
        </ol>

        @if (_accounts.Count == 0)
        {
            <div class="alert alert-info mb-0">@L["Import_NoAccount"]</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (_accounts.Count > 1)
                {
                    <select class="form-select form-select-sm w-auto" aria-label="@L["Common_Account"]" @bind="_accountId" disabled="@_busy">
                        @foreach (var account in _accounts)
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                }
                <InputFile class="form-control form-control-sm flex-grow-1" style="min-width: 0; max-width: 28rem" accept=".csv" multiple
                           OnChange="OnFilesChosen" disabled="@_busy" />
                @if (_busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span class="small text-body-secondary">@_progress</span>
                }
            </div>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_results.Count > 1)
{
    <div class="alert alert-success">
        @string.Format(L["Import_Summary"], _results.Count, _results.Sum(r => r.Result?.DividendsAdded ?? 0), _results.Sum(r => r.Result?.DividendsMatched ?? 0),
            _results.Sum(r => r.Result?.TransactionsAdded ?? 0), _results.Sum(r => r.Result?.TransactionsMatched ?? 0))
    </div>
}

@foreach (var (fileName, result, error) in _results)
{
    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-filetype-csv me-1"></i>@fileName</div>
        @if (error is not null)
        {
            <div class="card-body text-danger">@error</div>
        }
        else if (result is not null)
        {
            <ul class="list-group list-group-flush">
                <li class="list-group-item">@string.Format(L["Import_Dividends"], result.DividendsAdded, result.DividendsMatched)</li>
                <li class="list-group-item">@string.Format(L["Import_Cash"], result.TransactionsAdded, result.TransactionsMatched)</li>
                <li class="list-group-item">@string.Format(L["Import_OrdersSkipped"], result.OrdersSkipped)</li>
                @if (result.OtherSkipped.Count > 0)
                {
                    <li class="list-group-item">@L["Import_OtherSkipped"] @string.Join(", ", result.OtherSkipped.Select(o => $"{o.Key} ({o.Value})"))</li>
                }
                @foreach (var line in result.Errors)
                {
                    <li class="list-group-item list-group-item-warning">@string.Format(L["Import_LineError"], line.LineNumber, line.Message)</li>
                }
            </ul>
        }
    </div>
}

<section class="mt-4">
    <h2 class="h5">@L["Reports_Title"]</h2>
    @if (ReportOptions.Value.Enabled)
    {
        <p class="text-body-secondary">@string.Format(L["Reports_Intro"], (int)ReportOptions.Value.Interval.TotalDays)</p>
        @if (CoveredUntil is { } covered)
        {
            <p><i class="bi bi-check2-circle text-positive me-1"></i>@string.Format(L["Reports_CoveredUntil"], Fmt.Date(covered))</p>
        }
    }
    else
    {
        <div class="alert alert-info">@L["Reports_Disabled"]</div>
    }

    <DataGrid TItem="ReportRow" Items="_reports" Columns="ReportColumns" StorageKey="reports" ExportFileName="reports"
              DefaultSortKey="requested" DefaultSortDescending="true" EmptyText="@L["Reports_Empty"]" />
</section>

@code {
    private const long MaxFileSize = 20 * 1024 * 1024;
    private const int MaxFiles = 20;

    private IReadOnlyList<AccountOverview> _accounts = [];
    private int _accountId;
    private bool _busy;
    private string? _progress;
    private string? _error;
    private readonly List<(string FileName, CsvImportResult? Result, string? Error)> _results = [];
    private IReadOnlyList<ReportRow>? _reports;

    // Reports are asked for in order, so the latest imported one ends the covered history.
    private DateTimeOffset? CoveredUntil => _reports?.Where(r => r.Status == AccountReportStatus.Imported).Select(r => (DateTimeOffset?)r.To).Max();

    private IReadOnlyList<GridColumn<ReportRow>> ReportColumns => [
        new() { Key = "requested", Title = L["Reports_Requested"], Value = r => r.RequestedAt, Text = r => Fmt.DateTime(r.RequestedAt), MobileTitle = true },
        new() { Key = "period", Title = L["Reports_Period"], Value = r => r.From, Text = r => $"{Fmt.Date(r.From)} – {Fmt.Date(r.To)}" },
        new() { Key = "account", Title = L["Common_Account"], Value = r => r.AccountName, Filterable = true, HideBelow = "md" },
        new() { Key = "dividends", Title = L["Nav_Dividends"], Value = r => r.DividendsAdded, Text = r => string.Format(L["Reports_AddedCompleted"], r.DividendsAdded, r.DividendsMatched),
                AlignEnd = true, HideBelow = "lg" },
        new() { Key = "cash", Title = L["SyncJob_Transactions"], Value = r => r.TransactionsAdded, Text = r => string.Format(L["Reports_AddedCompleted"], r.TransactionsAdded, r.TransactionsMatched),
                AlignEnd = true, HideBelow = "lg" },
        new() { Key = "status", Title = L["Col_Result"], Value = r => StatusText(r.Status), Filterable = true,
                Template = r => @<div>
                    @switch (r.Status)
                    {
                        case AccountReportStatus.Imported:
                            <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> @StatusText(r.Status)</span>
                            break;
                        case AccountReportStatus.Requested:
                            <span class="badge badge-soft"><i class="bi bi-hourglass-split"></i> @StatusText(r.Status)</span>
                            break;
                        default:
                            <span class="badge text-bg-danger"><i class="bi bi-x-lg"></i> @StatusText(r.Status)</span>
                            break;
                    }
                    @if (r.Error is not null)
                    {
                        <div class="small text-body-secondary text-break mt-1">@r.Error</div>
                    }
                </div> },
    ];

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Overview.GetAccountsAsync();
        _accountId = _accounts.FirstOrDefault()?.Id ?? 0;
        _reports = await Reports.GetReportsAsync(null);
    }

    private string StatusText(AccountReportStatus status) => L[$"Reports_Status_{status}"];

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        _busy = true;
        _error = null;
        _results.Clear();

        try
        {
            if (e.FileCount > MaxFiles)
            {
                _error = string.Format(L["Import_TooMany"], MaxFiles);
                return;
            }

            var files = e.GetMultipleFiles(MaxFiles).OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase).ToList();
            for (var i = 0; i < files.Count; i++)
            {
                _progress = $"{i + 1} / {files.Count}: {files[i].Name}";
                StateHasChanged();
                _results.Add(await ImportAsync(files[i]));
            }
        }
        finally
        {
            _busy = false;
            _progress = null;
        }
    }

    private async Task<(string, CsvImportResult?, string?)> ImportAsync(IBrowserFile file)
    {
        try
        {
            // Copy first: the browser stream cannot be read synchronously by the parser.
            using var buffer = new MemoryStream();
            await using (var upload = file.OpenReadStream(MaxFileSize))
                await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            return (file.Name, await ImportService.ImportAsync(_accountId, buffer), null);
        }
        catch (FormatException)
        {
            return (file.Name, null, L["Import_NotAReport"]);
        }
        catch (IOException ex)
        {
            return (file.Name, null, ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV import of {File} failed", file.Name);
            return (file.Name, null, L["Import_Failed"]);
        }
    }
}
