@implements IDisposable
@inject ThemeService Theme

@* Charts are drawn by JS with fixed colours: they wait for the theme, and are rebuilt when it changes. *@
<div class="card chart-card h-100">
    @if (Title is not null)
    {
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <span class="me-auto">@Title</span>
            @Actions
        </div>
    }
    <div class="card-body">
        @if (IsEmpty)
        {
            <div class="chart-empty" style="min-height: @(Height)px">@EmptyText</div>
        }
        else if (!Theme.IsReady)
        {
            <div class="chart-empty" style="min-height: @(Height)px"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span></div>
        }
        else
        {
            <div @key="Theme.IsDark">@ChildContent(Theme.IsDark)</div>
        }
        @Footer
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The chart, given whether the theme is dark.</summary>
    [Parameter, EditorRequired] public RenderFragment<bool> ChildContent { get; set; } = default!;

    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public int Height { get; set; } = 300;

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
