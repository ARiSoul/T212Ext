@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject ThemeService Theme
@inject AccountContext AccountContext
@inject NavigationManager Navigation

<div class="app-shell @(_menuOpen ? "menu-open" : "")">
    <aside class="app-sidebar" aria-label="@L["Nav_Menu"]">
        <a class="app-brand" href="" @onclick="CloseMenu">
            <span class="app-brand-mark" aria-hidden="true"><i class="bi bi-bar-chart-fill"></i></span>
            <span>T212Ext</span>
        </a>

        <nav class="app-nav" @onclick="CloseMenu">
            <NavLink class="app-nav-link" href="" Match="NavLinkMatch.All"><i class="bi bi-grid-1x2"></i>@L["Nav_Overview"]</NavLink>
            <NavLink class="app-nav-link" href="dividends"><i class="bi bi-cash-coin"></i>@L["Nav_Dividends"]</NavLink>
            <NavLink class="app-nav-link" href="income"><i class="bi bi-bar-chart-line"></i>@L["Nav_Income"]</NavLink>
            <NavLink class="app-nav-link" href="positions"><i class="bi bi-pie-chart"></i>@L["Nav_Positions"]</NavLink>
            <NavLink class="app-nav-link" href="cash"><i class="bi bi-wallet2"></i>@L["Nav_Cash"]</NavLink>
            <NavLink class="app-nav-link" href="orders"><i class="bi bi-arrow-left-right"></i>@L["Nav_Orders"]</NavLink>
            <NavLink class="app-nav-link" href="tax"><i class="bi bi-file-earmark-text"></i>@L["Nav_Tax"]</NavLink>

            <div class="app-nav-section">@L["Nav_Data"]</div>
            <NavLink class="app-nav-link" href="import"><i class="bi bi-upload"></i>@L["Nav_Import"]</NavLink>
            <NavLink class="app-nav-link" href="sync"><i class="bi bi-arrow-repeat"></i>@L["Nav_SyncLog"]</NavLink>
            <NavLink class="app-nav-link" href="notifications"><i class="bi bi-bell"></i>@L["Nav_Notifications"]</NavLink>
        </nav>

        <div class="app-sidebar-footer">v@(Fmt.Version)</div>
    </aside>

    <div class="app-backdrop" @onclick="CloseMenu"></div>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button" class="btn btn-icon d-lg-none" aria-label="@L["Nav_Menu"]" @onclick="() => _menuOpen = !_menuOpen">
                <i class="bi bi-list"></i>
            </button>

            @if (AccountContext.Accounts.Count > 1)
            {
                <select class="form-select form-select-sm app-account" aria-label="@L["Common_Account"]"
                        value="@(AccountContext.AccountId?.ToString() ?? "")" @onchange="OnAccountChanged">
                    <option value="">@L["Common_AllAccounts"]</option>
                    @foreach (var account in AccountContext.Accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
            }

            <div class="ms-auto d-flex align-items-center gap-2">
                <SyncButton Compact="true" />
                <LanguageSelector />
                <ThemeSelector />
                <AuthorizeView>
                    <Authorized>
                        @* A plain form post: signing out clears a cookie, which needs a normal request. *@
                        <form method="post" action="auth/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-icon" aria-label="@L["Nav_SignOut"]" title="@L["Nav_SignOut"] (@context.User.Identity?.Name)">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span class="me-auto">@L["Error_PageFailed"]</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="Recover">@L["Common_TryAgain"]</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private bool _menuOpen;
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        AccountContext.Changed += OnContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Theme.InitializeAsync();
        await AccountContext.InitializeAsync();
    }

    private Task OnAccountChanged(ChangeEventArgs e) =>
        AccountContext.SelectAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private void CloseMenu() => _menuOpen = false;

    private void Recover() => _errorBoundary?.Recover();

    // A page that failed loads again when the person navigates away.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _errorBoundary?.Recover();

    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AccountContext.Changed -= OnContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
