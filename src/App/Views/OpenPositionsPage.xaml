<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Arisoul.T212.App.Views.OpenPositionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Arisoul.T212.App.Converters"
    xmlns:m="clr-namespace:Arisoul.T212.Models;assembly=Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Arisoul.T212.App.ViewModels"
    x:DataType="vm:OpenPositionsViewModel">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadPositionsCommand}" EventName="Loaded" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegativePositiveConverter x:Key="NegativePositiveConverter" />
            <converters:PositiveConverter x:Key="PositiveConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView Command="{Binding RefreshingCommand}" IsRefreshing="{Binding IsRefreshing}">
        <Grid RowDefinitions="0.10*,*">
            <ScrollView
                Grid.Row="0"
                Margin="0,0,0,5"
                Orientation="Horizontal">
                <HorizontalStackLayout Padding="10" Spacing="5">
                    <Button
                        Command="{Binding ManualRefreshCommand}"
                        IsVisible="{Binding IsWindows}"
                        Text="Refresh" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Positions:" />
                    <Label FontSize="Medium" Text="{Binding Items.Count}" />
                    <Label
                        Padding="15,0,0,0"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Invested:" />
                    <Label FontSize="Medium" Text="{Binding TotalInvested, StringFormat='{0:#,0.#00} €'}" />
                    <Label
                        Padding="15,0,0,0"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Return:" />
                    <Label FontSize="Medium" Text="{Binding TotalReturn, StringFormat='{0:#,0.#00} €'}" />
                    <Label
                        Padding="15,0,0,0"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        Text="Dividends:" />
                    <Label FontSize="Medium" Text="{Binding TotalDividends, StringFormat='{0:#,0.#00} €'}" />
                </HorizontalStackLayout>
            </ScrollView>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PositionModel">
                        <VerticalStackLayout Padding="15,0,15,5">
                            <Border Padding="5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OpenPositionsViewModel}}, Path=GoToDetailsCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid
                                    ColumnDefinitions="0.30*,0.40*,*"
                                    ColumnSpacing="2"
                                    RowDefinitions="*,*">

                                    <!--  Short name (column 0)  -->
                                    <toolkit:AvatarView
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        BackgroundColor="BlueViolet"
                                        FontAttributes="Bold"
                                        Text="{Binding Instrument.Shortname}" />
                                    <toolkit:AvatarView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        BackgroundColor="Orange"
                                        FontAttributes="Bold"
                                        HeightRequest="25"
                                        Text="{Binding Instrument.CurrencyCode}"
                                        TextColor="Black" />

                                    <!--  Name and Shares (column 1)  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Text="{Binding Instrument.Name}" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="0,3,0,0"
                                        Text="{Binding Quantity, StringFormat='{0:#,0.#0000} Shares'}"
                                        TextColor="Gray" />

                                    <!--  column 2  -->
                                    <Grid
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        ColumnDefinitions="0.25*,0.6*,0.25*,0.9*"
                                        RowDefinitions="*,*,*,*">

                                        <!--  Invested and Return  -->
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Inv:" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="Micro"
                                            Text="{Binding Invested, StringFormat='{0:#,0.#0} €'}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Ret:" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            FontSize="Micro"
                                            Text="{Binding Ppl, StringFormat='{0:#,0.#0} €'}"
                                            TextColor="{Binding Ppl, Converter={StaticResource NegativePositiveConverter}}" />

                                        <!--  Current and Average Price  -->
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Cur:" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="Micro"
                                            Text="{Binding CurrentPrice, StringFormat='{0:#,0.#0} €'}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Avg:" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            FontSize="Micro"
                                            Text="{Binding AveragePrice, StringFormat='{0:#,0.#0} €'}" />

                                        <!--  Fx Impact and Initial Date  -->
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="FxI:" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            FontSize="Micro"
                                            Text="{Binding FxPpl, StringFormat='{0:#,0.#00} €'}"
                                            TextColor="{Binding FxPpl, Converter={StaticResource NegativePositiveConverter}}" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Sin:" />
                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            FontSize="Micro"
                                            Text="{Binding InitialFillDate}" />

                                        <!--  Dividends  -->
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Div:" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            FontSize="Micro"
                                            Text="{Binding Dividends.Count}" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            FontSize="Micro"
                                            Text="Tot Div:" />
                                        <Label
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            FontSize="Micro"
                                            Text="{Binding TotalDividendsInEuro, StringFormat='{0:#,0.#00} €'}"
                                            TextColor="{Binding TotalDividendsInEuro, Converter={StaticResource PositiveConverter}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
