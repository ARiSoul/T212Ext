<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Arisoul.T212.App.Views.OpenPositionsDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Arisoul.T212.App.Converters"
    xmlns:ctrl="clr-namespace:Arisoul.T212.App.Controls"
    xmlns:m="clr-namespace:Arisoul.T212.Models;assembly=Models"
    xmlns:models="clr-namespace:Arisoul.T212.App.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Arisoul.T212.App.ViewModels"
    x:DataType="vm:OpenPositionsDetailViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NegativePositiveConverter x:Key="NegativePositiveConverter" />
            <converters:PositiveConverter x:Key="PositiveConverter" />
            <converters:InvertedNegativePositiveConverter x:Key="InvertedNegativePositiveConverter" />
            <converters:InvertedNegativePositiveArrowConverter x:Key="InvertedNegativePositiveArrowConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding LoadTickerOrdersCommand}" EventName="Loaded" />
    </ContentPage.Behaviors>

    <ScrollView Padding="5">
        <Grid RowDefinitions="*,*">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="0.5*,0.7*,*"
                RowDefinitions="0.5*,0.5*,*">

                <!--  Short name  -->
                <VerticalStackLayout
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Spacing="5">
                    <toolkit:AvatarView
                        BackgroundColor="BlueViolet"
                        FontAttributes="Bold"
                        Text="{Binding Item.Instrument.Shortname}" />
                    <toolkit:AvatarView
                        BackgroundColor="Orange"
                        FontAttributes="Bold"
                        HeightRequest="25"
                        Text="{Binding Item.Instrument.CurrencyCode}"
                        TextColor="Black" />
                </VerticalStackLayout>

                <!--  Name and Shares  -->
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Item.Instrument.Name}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding Item.Quantity, StringFormat='{0:#,0.#0000} Shares'}"
                    TextColor="Gray" />

                <Grid
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    ColumnDefinitions="*,*,*,*"
                    RowDefinitions="*,*,*">

                    <!--  Invested and Return  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="INV:" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{Binding Item.Invested, StringFormat='{0:#,0.#0} €'}" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        Text="RET:" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="3"
                        Text="{Binding Item.Ppl, StringFormat='{0:#,0.#0} €'}"
                        TextColor="{Binding Item.Ppl, Converter={StaticResource NegativePositiveConverter}}" />

                    <!--  Current and Average Price  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Current:" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Item.CurrentPrice, StringFormat='{0:#,0.#0} €'}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        Text="Average:" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="3"
                        Text="{Binding Item.AveragePrice, StringFormat='{0:#,0.#0} €'}" />

                    <!--  Fx Impact and Initial Date  -->
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="Fx Impact:" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding Item.FxPpl, StringFormat='{0:#,0.#00} €'}"
                        TextColor="{Binding Item.FxPpl, Converter={StaticResource NegativePositiveConverter}}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="2"
                        FontAttributes="Bold"
                        Text="Since:" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="3"
                        Text="{Binding Item.InitialFillDate}" />
                </Grid>


            </Grid>

            <ctrl:TabView Grid.Row="1" Padding="15">
                <ctrl:TabView.Tabs>
                    <ctrl:CustomTab Caption="Dividends">
                        <ctrl:CustomTab.Content>
                            <ListView
                                IsRefreshing="{Binding IsRefreshing}"
                                ItemsSource="{Binding Item.Dividends}"
                                RefreshCommand="{Binding LoadTickerOrdersCommand}">
                                <ListView.Header>
                                    <HorizontalStackLayout Padding="10,0,0,0">
                                        <Label
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            Text="Total:" />
                                        <Label Text="{Binding Item.TotalDividendsInEuro, StringFormat='{0:#,0.#00} €'}" TextColor="{Binding Item.TotalDividendsInEuro, Converter={StaticResource PositiveConverter}}" />
                                        <Label
                                            Padding="15,0,5,0"
                                            FontAttributes="Bold"
                                            Text="Records:" />
                                        <Label Text="{Binding Item.Dividends.Count}" />
                                    </HorizontalStackLayout>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="m:HistoryDividendItem">
                                        <ViewCell>
                                            <StackLayout>
                                                <HorizontalStackLayout Padding="10" Spacing="15">
                                                    <Label Text="{Binding Amount, StringFormat='{0:#,0.#00} €'}" WidthRequest="100" />
                                                    <Label Text="{Binding PaidOn}" />
                                                </HorizontalStackLayout>
                                                <Line
                                                    HorizontalOptions="Fill"
                                                    Stroke="White"
                                                    X2="{Binding Width, Source={RelativeSource Self}}" />
                                            </StackLayout>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctrl:CustomTab.Content>
                    </ctrl:CustomTab>
                    <ctrl:CustomTab Caption="Orders">
                        <ctrl:CustomTab.Content>
                            <ListView ItemsSource="{Binding Item.Orders}">
                                <ListView.Header>
                                    <HorizontalStackLayout Padding="10,0,0,0">
                                        <Label
                                            Padding="0,0,5,0"
                                            FontAttributes="Bold"
                                            Text="Total:" />
                                        <Label Text="{Binding Item.Invested, StringFormat='{0:#,0.#00} €'}" TextColor="{Binding Item.Invested, Converter={StaticResource PositiveConverter}}" />
                                        <Label
                                            Padding="15,0,5,0"
                                            FontAttributes="Bold"
                                            Text="Records:" />
                                        <Label Text="{Binding Item.Orders.Count}" />
                                    </HorizontalStackLayout>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="m:HistoryOrderModel">
                                        <ViewCell>
                                            <StackLayout>
                                                <HorizontalStackLayout Padding="10" Spacing="15">
                                                    <Label
                                                        FontFamily="FontAwesomeSolid"
                                                        Text="{Binding FilledValue, Converter={StaticResource InvertedNegativePositiveArrowConverter}}"
                                                        TextColor="{Binding FilledValue, Converter={StaticResource NegativePositiveConverter}}" />
                                                    <Label
                                                        Text="{Binding FilledValue, StringFormat='{0:#,0.#00} €'}"
                                                        TextColor="{Binding FilledValue, Converter={StaticResource NegativePositiveConverter}}"
                                                        WidthRequest="150" />
                                                    <Label Text="{Binding DateCreated}" WidthRequest="200" />
                                                    <Label Text="{Binding FillPrice, StringFormat='Value in position currency: {0:#,0.#00}'}" />
                                                </HorizontalStackLayout>
                                                <Line
                                                    HorizontalOptions="Fill"
                                                    Stroke="White"
                                                    X2="{Binding Width, Source={RelativeSource Self}}" />
                                            </StackLayout>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ctrl:CustomTab.Content>
                    </ctrl:CustomTab>
                </ctrl:TabView.Tabs>
            </ctrl:TabView>
        </Grid>
    </ScrollView>
</ContentPage>
