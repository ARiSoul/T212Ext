<?xml version="1.0" encoding="utf-8"?>
<!-- This repository only uses packages from nuget.org. Clearing machine-wide sources keeps
     local builds and CI identical and avoids failures from private feeds that need a login. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
