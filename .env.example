# Copy to .env on the server (cp .env.example .env) and fill in. .env is not committed.
# Never paste these values into chats, issues or logs. See docs/DEPLOYMENT.md.

# ── Database ────────────────────────────────────────────────
# Password of the "t212ext" login on the shared SQL Server (ops/db/create-database.sh creates it).
# Generate it with: openssl rand -base64 33 | tr -d '/+=\n'
T212EXT_DB_PASSWORD=

# ── Sign-in ─────────────────────────────────────────────────
# The hash comes from: docker compose run --rm -it t212ext hash-password
Auth__Users__0__Username=
Auth__Users__0__PasswordHash=
# Optional but recommended: docker compose run --rm t212ext new-totp-secret <username>
Auth__Users__0__TotpSecret=

# ── Trading 212 accounts ────────────────────────────────────
# One block per account (0, 1, …). Key: short id used in the database, never change it.
# ApiSecret: empty for a legacy key without a secret. Restrict the key to the server's IP address.
T212__Accounts__0__Key=invest
T212__Accounts__0__Name=Invest
T212__Accounts__0__Environment=Live
T212__Accounts__0__ApiKey=
T212__Accounts__0__ApiSecret=

# ── Optional ────────────────────────────────────────────────
# Ui__DefaultCulture=pt-PT
# Sync__Interval=06:00:00
